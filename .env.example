HOST=127.0.0.1
PORT=4318
PUBLIC_ORIGIN=http://localhost:5173
# Supabase project intended specifically for this pilot. No service-role key needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Answer model. Production: INFERENCE_PROVIDER=openai with gpt-6-luna (the key comes from OPENAI_API_KEY).
# Leave INFERENCE_PROVIDER empty for any other OpenAI-compatible endpoint (e.g. a local NIM), including /v1.
# Never use VITE_ for secrets.
INFERENCE_PROVIDER=openai
INFERENCE_BASE_URL=https://api.openai.com/v1
INFERENCE_MODEL=gpt-6-luna
INFERENCE_API_KEY=
# none | low | medium | high: reasoning for claim extraction, review and writing (short steps always use none).
INFERENCE_REASONING_EFFORT=low
# Daily spend backstop in USD, priced per million tokens (plus web searches); 0 disables.
MODEL_DAILY_BUDGET_USD=5
INFERENCE_PRICE_INPUT_PER_M=0.10
INFERENCE_PRICE_OUTPUT_PER_M=0.50
WEB_SEARCH_PRICE=0.01
# Who may use the app: open (local/tests) | paid (model routes need a verified account) | verified (whole app).
ACCESS_POLICY=open
ASK_DAILY_LIMIT=20
ASK_WEEKLY_LIMIT=100
TRANSLATE_DAILY_LIMIT=60
AUTH_RATE_LIMIT=20
# Same value as ~/.swiss-proxy-key next to the hosting's public_html (see deploy/switzerland/proxy.php).
PROXY_SHARED_SECRET=
# Optional TypeSafe Jev evidence review. Keep shadow mode until its recorded
# decisions pass the evaluation set; Jev never writes answer prose.
TYPESAFE_MODE=off
TYPESAFE_ENDPOINT=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY=
TYPESAFE_AUTO_ACCEPT=0.8
# Operator-provided health URLs for actual deployed VSS and Riva HTTP gateways.
VSS_HEALTH_URL=
RIVA_HEALTH_URL=
# Translation: openai uses the answer model with the same number checks; otherwise a Riva-style
# /translate service at TRANSLATION_BASE_URL (the LaunchPad GPU period).
TRANSLATION_PROVIDER=openai
TRANSLATION_BASE_URL=
# Experimental visual video search (Cosmos VSS on a GPU); empty disables it.
VSS_EMBED_BASE_URL=

# Optional feedback delivery: verified sender on a restricted Resend sending key.
FEEDBACK_RESEND_KEY=
FEEDBACK_FROM=
# Public corpus backups use a separate protected 32-byte key, never Supabase user credentials.
CORPUS_BACKUP_KEY_FILE=
CORPUS_BACKUP_DIRECTORY=

# Optional, existing Supabase SAML organization provider. Leave empty until configured.
SUPABASE_SSO_PROVIDER_ID=

# Optional web research beside the parliamentary record (OpenAI Responses API + web_search tool).
# Results are always shown separately and labelled "Beyond the parliamentary record".
OPENAI_API_KEY=
WEB_RESEARCH_MODEL=
WEB_RESEARCH_DAILY_LIMIT=60
WEB_RESEARCH_MAX_TOKENS=900

# Hybrid retrieval: E5 semantic ranks fused with full-text search. Needs the int8 index from
# scripts/export-embedding-index.py in data/embeddings/ and the ONNX query model (downloaded on first use).
HYBRID_RETRIEVAL=off
EMBEDDING_CACHE_DIR=data/models

# NVIDIA hosted API catalog (the GPU-period fallback; not used with INFERENCE_PROVIDER=openai).
# INFERENCE_PROVIDER=nvidia-catalog forces it. Overloaded on 24 Sep 2026: 9 of 60 calls succeeded.
NVIDIA_API_KEY=
INFERENCE_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# Tried when the first catalog model is overloaded (429/5xx); comma-separated, empty string disables.
INFERENCE_FALLBACK_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
